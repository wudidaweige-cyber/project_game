# =============================================================================
# 游戏平台账号租赁智能运营分析系统 - 环境变量模板（可提交 Git）
# -----------------------------------------------------------------------------
# 用法：复制本文件为 .env，再填写真实密钥与本机连接信息
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
# 前期原则：本机跑通功能，不依赖 Docker；.env 勿提交到 Git
# =============================================================================

# -----------------------------------------------------------------------------
# 【应用基础】前期必填
# -----------------------------------------------------------------------------

# 运行环境：dev | test | prod
APP_ENV=dev

# FastAPI 监听地址；本机开发可用 127.0.0.1 或 0.0.0.0
APP_HOST=0.0.0.0

# FastAPI 端口（与系统设计一致：前端代理指向 8888）
APP_PORT=8888

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# 允许跨域的前端源（多个用英文逗号分隔）；Vite 默认 5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT / 会话签名密钥（鉴权落地后必填；请换成足够长的随机串）
JWT_SECRET=please-change-me-to-a-long-random-string
# Token 有效期（分钟），默认 12 小时
JWT_EXPIRE_MINUTES=720


# -----------------------------------------------------------------------------
# 【PostgreSQL】前期必填（本机安装或已有实例即可）
# -----------------------------------------------------------------------------

# 业务库连接串（SQLAlchemy/psycopg 风格示例）
# 格式：postgresql+psycopg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/game_ops

# AI / MCP 只读连接（建议与业务库分离账号；前期可与 DATABASE_URL 相同）
# 代码层仍强制仅允许 SELECT，禁止写操作
DATABASE_READONLY_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/game_ops


# -----------------------------------------------------------------------------
# 【大模型 LLM】前期必填（OpenAI Compatible）
# -----------------------------------------------------------------------------

# 接口 Base URL，需带 /v1（以实际厂商文档为准）
# 示例：通义 / DeepSeek / 其他兼容网关
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# API Key（勿提交真实密钥到仓库）
LLM_API_KEY=sk-your-llm-api-key

# 对话 / Agent 使用的模型名（按账号可用模型填写）
# 示例：qwen-plus、qwen-turbo、deepseek-chat
LLM_MODEL=qwen-plus


# -----------------------------------------------------------------------------
# 【Embedding】RAG 阶段再填；看板 / NL2SQL 可先不配
# -----------------------------------------------------------------------------

# Embedding 服务地址；可与 LLM 同源
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Embedding API Key；可与 LLM_API_KEY 相同
EMBEDDING_API_KEY=sk-your-embedding-api-key

# 向量模型名（按厂商填写，如 text-embedding-v3 / text-embedding-v4）
EMBEDDING_MODEL=text-embedding-v4


# -----------------------------------------------------------------------------
# 【RAG 检索】Hybrid / Rerank
# -----------------------------------------------------------------------------

# 是否默认开启 Hybrid（向量 + BM25 + RRF）；false 则仅向量
RAG_HYBRID_ENABLED=true

# 各路召回候选数（融合/重排前）
RAG_CANDIDATE_K=20

# RRF 常数 k（常用 60）
RAG_RRF_K=60

# 是否启用 Rerank（需配置下方 RERANK_*；失败时自动回退原排序）
RAG_RERANK_ENABLED=true

# 送入 Rerank 的候选上限
RAG_RERANK_TOP_N=10

# -----------------------------------------------------------------------------
# 【Rerank】RAG_RERANK_ENABLED=true 时生效
# -----------------------------------------------------------------------------

# Rerank 服务地址（不使用可留空）
RERANK_BASE_URL=

# Rerank API Key
RERANK_API_KEY=

# Rerank 模型名
RERANK_MODEL=


# -----------------------------------------------------------------------------
# 【Milvus】档 A：虚拟机 Docker 填 http://<虚拟机IP>:19530；留空则走本机 Lite
# 说明见 docker/README.md。不要填 http://127.0.0.1:19530（应用在 Windows 时会回退 Lite）
# -----------------------------------------------------------------------------

# Milvus：未部署服务时请留空，自动使用 data/milvus/ops_knowledge.db（Milvus Lite）
MILVUS_URI=

# Milvus Token（未开启认证则留空）
MILVUS_TOKEN=

# 知识库 Collection 名称
MILVUS_COLLECTION=ops_knowledge


# -----------------------------------------------------------------------------
# 【Redis】Agent 异步队列；留空则使用进程内队列（无需 Redis）
# 虚拟机档 A：REDIS_URL=redis://<虚拟机IP>:6379/0
# -----------------------------------------------------------------------------

# 示例：redis://127.0.0.1:6379/0
REDIS_URL=


# -----------------------------------------------------------------------------
# 【LangSmith】可观测性，功能跑通后再开
# -----------------------------------------------------------------------------

# 是否开启追踪：true | false
LANGSMITH_TRACING=false

# LangSmith API Key
LANGSMITH_API_KEY=

# LangSmith 项目名（便于在控制台筛选本项目链路）
LANGSMITH_PROJECT=game-ops-agent


# -----------------------------------------------------------------------------
# 【安全与 Agent 行为】建议保持默认
# -----------------------------------------------------------------------------

# AI 数据分析是否仅允许 SELECT（必须为 true）
AI_SQL_READONLY=true

# 单次 LLM / Agent 超时秒数（可按模型调整）
AGENT_TIMEOUT_SECONDS=120

# 是否允许策略分析写业务库（第一阶段必须为 false）
STRATEGY_ALLOW_WRITE=false

# Phase A：鉴权落地前，AI 会话归属的演示用户（Phase B 换真实登录）
DEMO_USER_ID=00000000-0000-4000-8000-000000000001
DEMO_USERNAME=demo_operator
DEMO_DISPLAY_NAME=演示运营
